# 复制此文件为 .env，填入你的 Key（三选一即可）
# 真正生效的是 .env；这个文件只是模板，不要往里填真 Key

# ---------- 方案 A：GPT 中转站（当前默认）----------
# 把学长给的 key 粘在 LLM_API_KEY 后面，不加引号、不留空格
LLM_BASE_URL=https://api.openai-next.com/v1
LLM_MODEL=gpt-5.6-sol
LLM_API_KEY=

# 可选：图片模型（第 3 批出图才用），先用 /api/models 查到真名再填
# IMAGE_MODEL=

# ---------- 方案 B：DeepSeek 官方（本机实测可直连）----------
# DEEPSEEK_API_KEY=

# ---------- 方案 C：智谱 GLM（有免费额度）----------
# ZHIPU_API_KEY=

# ---------- 其他任意 OpenAI 兼容端点 ----------
# 硅基流动 / 通义 / Moonshot / 本地 ollama 都行，写 .../v1 即可
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# LLM_API_KEY=

# ---------- 改端口 ----------
# PORT=7788
