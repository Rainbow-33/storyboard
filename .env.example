# 复制此文件为 .env，填入你的 Key（任选一个即可）
# 注意：真正生效的是 .env，这个文件只是模板，不要往里填真 Key

# DeepSeek 官方（推荐，本机实测可直连）
DEEPSEEK_API_KEY=

# 智谱 GLM（有免费额度）
ZHIPU_API_KEY=

# 可选：任意 OpenAI 兼容端点（硅基流动 / 通义 / Moonshot / 本地 ollama）
# LLM_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# 可选：改端口
# PORT=7788
